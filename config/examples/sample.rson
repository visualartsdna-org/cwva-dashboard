{
    # A DEMONSTRATION over cwva-py's sample collection, kept apart from any
    # real one: its own folder, its own sandbox. The sample's records use the
    # visualartsdna.org domain, so this config does too; a real collection
    # never should (use folder.rson, git.rson or gcp.rson for that).
    #
    #   mkdir -p ~/cwva-py/sample/inbox
    #   python3 -m zipfile -e ~/cwva-py/main/sample-data/cwvaContent-sample.zip \
    #       ~/cwva-py/sample
    #   CWVA_DASHBOARD_CONFIG=config/examples/sample.rson \
    #       python scripts/sync_shadow_to_qa.py --adopt
    #   CWVA_DASHBOARD_CONFIG=config/examples/sample.rson \
    #       uvicorn cwva_dashboard.main:create_app --factory --port 8100
    "extends": "folder.rson",

    "domain": "http://visualartsdna.org",
    "host": "http://visualartsdna.org",

    "sandbox": {"stage_root": "~/.local/share/cwva-dashboard/sample-sandbox"},
    "inbox": {"path": "~/cwva-py/sample/inbox"},
    "environment": {"label": "SAMPLE", "colour": "blue"},
    "sot": {"path": "~/cwva-py/sample"}
}
