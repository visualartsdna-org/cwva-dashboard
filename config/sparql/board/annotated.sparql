PREFIX the: <http://visualartsdna.org/thesaurus/>
PREFIX vad: <http://visualartsdna.org/model/>
PREFIX ops: <http://visualartsdna.org/operations/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# Annotated: the work carries a concept the entry form does not set. The
# entry form sets the paper and the artist profile; anything else pointing at
# the thesaurus came from Annotate Work. Dated only if an edit stamped it.
SELECT ?work ?at WHERE {
  ?work ?p ?concept .
  FILTER(STRSTARTS(STR(?p), STR(vad:)) && STRSTARTS(STR(?concept), STR(the:)))
  FILTER(?p NOT IN (vad:hasPaper, vad:hasArtistProfile, vad:background))
  OPTIONAL { ?work schema:dateModified ?at }
}
