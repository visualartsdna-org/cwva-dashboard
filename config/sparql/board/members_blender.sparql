PREFIX the: <http://visualartsdna.org/thesaurus/>
PREFIX vad: <http://visualartsdna.org/model/>
PREFIX ops: <http://visualartsdna.org/operations/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# Workflow B: every Blender composition.
SELECT ?work ?label ?created WHERE {
  ?work a vad:BlenderComposition ; rdfs:label ?label .
  OPTIONAL { ?work schema:dateCreated ?created }
}
