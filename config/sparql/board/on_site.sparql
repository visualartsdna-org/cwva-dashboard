PREFIX the: <http://visualartsdna.org/thesaurus/>
PREFIX vad: <http://visualartsdna.org/model/>
PREFIX ops: <http://visualartsdna.org/operations/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# On site: the scraper's snapshot says the work appears on a site. No date:
# the snapshot is deliberately timestamp-free (idempotent).
SELECT ?work WHERE { ?work vad:workOnSite ?site . }
