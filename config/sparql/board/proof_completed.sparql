PREFIX the: <http://visualartsdna.org/thesaurus/>
PREFIX vad: <http://visualartsdna.org/model/>
PREFIX ops: <http://visualartsdna.org/operations/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# Proof completed: the work has proofs and every one carries its anchor.
SELECT ?work ?at ?record WHERE {
  ?record a vad:ProofEvent ; vad:assetOf ?work ; vad:transaction ?tx .
  OPTIONAL { ?record vad:timestamp ?at }
  FILTER NOT EXISTS {
    ?open a vad:ProofEvent ; vad:assetOf ?work .
    FILTER NOT EXISTS { ?open vad:transaction ?t2 }
  }
}
