PREFIX the: <http://visualartsdna.org/thesaurus/>
PREFIX vad: <http://visualartsdna.org/model/>
PREFIX ops: <http://visualartsdna.org/operations/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# DTS complete: every criticism entity tagged to the work has its summary
# curated (the last of the six stamps). Dated by that stamp.
SELECT ?work ?at ?record WHERE {
  ?record skos:inScheme the:entities ; the:tag ?work ; the:mdDocument ?doc ;
          ops:status/ops:summaryCurated/ops:at ?at .
  FILTER NOT EXISTS {
    ?other skos:inScheme the:entities ; the:tag ?work ; the:mdDocument ?d2 .
    FILTER NOT EXISTS { ?other ops:status/ops:summaryCurated ?x }
  }
}
