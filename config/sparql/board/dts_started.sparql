PREFIX the: <http://visualartsdna.org/thesaurus/>
PREFIX vad: <http://visualartsdna.org/model/>
PREFIX ops: <http://visualartsdna.org/operations/>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# DTS under way: a criticism entity has stamps but no curated summary. The
# note is the status label, i.e. what last happened.
SELECT ?work ?at ?record ?note WHERE {
  ?record skos:inScheme the:entities ; the:tag ?work ; the:mdDocument ?doc ;
          ops:status ?st .
  ?st ?stage ?stamp . ?stamp ops:at ?at .
  OPTIONAL { ?st rdfs:label ?note }
  FILTER NOT EXISTS { ?st ops:summaryCurated ?x }
}
